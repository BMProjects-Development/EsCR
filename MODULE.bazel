module(name = "escr", version = "1.0.0")

KOTLIN_VERSION = "2.4.20"
MINECRAFT_VERSION = "26.3"
NEOFORGE_VERSION = "26.3.0.4-beta"
NEOFORM_VERSION = "26.3-1"
TOUCHCONTROLLER_COMMIT = "ad4452454aa349e64648c84b0464236f3f6fe9e8"
JEI_VERSION = "31.16.0.87"
REI_VERSION = "26.3.824"
EMI_VERSION = "1.1.24+1.21.1"

bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_kotlin", version = KOTLIN_VERSION)
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_mc", version = "0.0.1")
bazel_dep(name = "touchcontroller", version = "0.3.1-alpha")

git_override(
    module_name = "rules_mc",
    remote = "https://github.com/TouchController/TouchController.git",
    commit = TOUCHCONTROLLER_COMMIT,
    strip_prefix = "rules_mc",
    sparse_checkout_patterns = ["/rules_mc/"],
    patches = ["//tools/build:rules_mc.patch"],
    patch_strip = 1,
)
git_override(
    module_name = "touchcontroller",
    remote = "https://github.com/TouchController/TouchController.git",
    commit = TOUCHCONTROLLER_COMMIT,
    sparse_checkout_patterns = ["/MODULE.bazel", "/BUILD.bazel", "/LICENSE", "/private/", "/repo/", "/rule/"],
    patches = ["//tools/build:touchcontroller.patch"],
    patch_strip = 1,
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    lock_file = "//tools/build:maven.lock.json",
    fail_on_missing_checksum = False,
    known_contributing_modules = ["protobuf"],
    artifacts = [
        "org.jetbrains.kotlin:kotlin-reflect:" + KOTLIN_VERSION,
        "org.jetbrains.kotlinx:kotlinx-serialization-core-jvm:1.11.0",
        "org.jetbrains.kotlinx:kotlinx-serialization-json-jvm:1.11.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core-jvm:1.11.0",
        "org.spongepowered:mixin:0.8.7",
        "io.github.llamalad7:mixinextras-common:0.5.5",
        "org.ow2.asm:asm:9.10.1",
        "net.fabricmc:class-tweaker:0.3.0",
        "org.yaml:snakeyaml:2.4",
        "com.google.code.gson:gson:2.14.0",
        "junit:junit:4.13.2",
        "org.jspecify:jspecify:1.0.0",
        "io.codechicken:DiffPatch:jar:all:2.1.0.43",
        "net.neoforged.jst:jst-cli-bundle:2.0.11",
    ],
    repositories = [
        "https://repo.maven.apache.org/maven2",
        "https://maven.fabricmc.net",
        "https://repo.spongepowered.org/repository/maven-public",
        "https://maven.neoforged.net/releases",
    ],
)
maven.install(
    name = "fabric_maven",
    lock_file = "//tools/build:fabric_maven.lock.json",
    fail_on_missing_checksum = False,
    artifacts = [
        "org.ow2.asm:asm:9.10.1",
        "org.ow2.asm:asm-analysis:9.10.1",
        "org.ow2.asm:asm-commons:9.10.1",
        "org.ow2.asm:asm-tree:9.10.1",
        "org.ow2.asm:asm-util:9.10.1",
        "net.fabricmc:sponge-mixin:0.17.4+mixin.0.8.7",
        "net.fabricmc:fabric-loader:0.19.5",
        "net.fabricmc.fabric-api:fabric-api:0.160.7+" + MINECRAFT_VERSION,
        "net.fabricmc:fabric-language-kotlin:1.14.1+kotlin." + KOTLIN_VERSION,
        "maven.modrinth:iris:1.11.6+" + MINECRAFT_VERSION + "-fabric",
    ],
    repositories = [
        "https://maven.fabricmc.net",
        "https://repo.maven.apache.org/maven2",
        "https://api.modrinth.com/maven",
    ],
)
maven.install(
    name = "neoforge_maven",
    lock_file = "//tools/build:neoforge_maven.lock.json",
    fail_on_missing_checksum = False,
    excluded_artifacts = ["net.neoforged:minecraft-dependencies", "net.neoforged:neoform", "net.neoforged.fancymodloader:junit-fml"],
    artifacts = [
        "com.mojang:logging:1.7.12",
        "net.neoforged:neoforge:jar:universal:" + NEOFORGE_VERSION,
        "dev.nyon:KotlinLangForge:2.14.1-k" + KOTLIN_VERSION + "-3.1+neoforge",
        "maven.modrinth:iris:1.11.4+26.2-neoforge",
    ],
    repositories = [
        "https://maven.neoforged.net/releases",
        "https://libraries.minecraft.net",
        "https://repo.maven.apache.org/maven2",
        "https://maven.fabricmc.net",
        "https://repo.nyon.dev/releases",
        "https://api.modrinth.com/maven",
    ],
)
maven.install(
    name = "additions_maven",
    lock_file = "//tools/build:additions_maven.lock.json",
    fail_on_missing_checksum = False,
    artifacts = [
        "mezz.jei:jei-26.3-common-api:" + JEI_VERSION,
        "me.shedaniel:RoughlyEnoughItems-api:" + REI_VERSION,
        "dev.emi:emi-neoforge:jar:api:" + EMI_VERSION,
    ],
    repositories = [
        "https://maven.blamejared.com",
        "https://maven.shedaniel.me",
        "https://maven.terraformersmc.com/releases",
        "https://maven.architectury.dev",
        "https://maven.fabricmc.net",
        "https://repo.maven.apache.org/maven2",
    ],
)
use_repo(maven, "maven", "fabric_maven", "neoforge_maven", "additions_maven")

minecraft = use_extension("@rules_mc//:extensions.bzl", "minecraft")
minecraft.version(version = MINECRAFT_VERSION, client = True, server = True, assets = True)
use_repo(minecraft, "minecraft", "minecraft_assets")

neoform = use_extension("@touchcontroller//repo:neoform.bzl", "neoform")
neoform.version(
    version = NEOFORM_VERSION,
    sha256 = "df5ff673af2d92b7796f31014d3d3c6ebddbf5206ca8dbcdac055375cfbe9450",
    client_jar = "@minecraft//" + MINECRAFT_VERSION + ":client",
    server_jar = "@minecraft//" + MINECRAFT_VERSION + ":server",
    client_libraries = "@minecraft//" + MINECRAFT_VERSION + ":client_libraries",
)
neoform.pin(pin_file = "//tools/build:neoform_pin.txt")
use_repo(neoform, "neoform_pin", neoform = "neoform_" + NEOFORM_VERSION.replace(".", "_").replace("-", "_"))

neoforge = use_extension("@touchcontroller//repo:neoforge.bzl", "neoforge")
neoforge.version(
    version = NEOFORGE_VERSION,
    java_target = 25,
    userdev_sha256 = "5367ab059a47610397b1e50398eb307037b71a656cd9e60ff5f034678d1a8938",
    sources_sha256 = "a6f06be1f1dcbe3d6ce80afc003d0b76b50c36fcfe149042f7430199983d1010",
    universal_sha256 = "779300e599956869807cebc0ad093ce301bc857a2f3a4a0023b89757150b4c3a",
    joined_patched_sources = "@neoform//tasks/joined_patch",
)
neoforge.pin(pin_file = "//tools/build:neoforge_pin.txt")
use_repo(neoforge, "neoforge_pin", neoforge = "neoforge_" + NEOFORGE_VERSION.replace(".", "_").replace("-", "_").replace("+", "_"))

ecr = use_extension("//tools/build:repositories.bzl", "ecr_repositories")
ecr.project(
    archives_name = "ECR",
    mod_id = "escr",
    mod_name = "Essential Craft: Reimagined",
    mod_version = "1.0.0",
    mod_group = "com.algorithmlx",
    mod_description = "",
    mod_license = "ASAL-1.0",
    mod_authors = "AlgorithmLX",
    minecraft_version = MINECRAFT_VERSION,
    kotlin_version = KOTLIN_VERSION,
    fabric_loader_version = "0.19.5",
    neoforge_version = NEOFORGE_VERSION,
    neoform_version = NEOFORM_VERSION,
    klf_version = "2.14.1",
    java_version = 25,
    development_username = "AlgorithmLX",
)
ecr.project(
    name = "ecr_additions_project",
    archives_name = "EsCR-Oddities",
    mod_id = "escr_oddities",
    mod_name = "EsCR Oddities",
    mod_version = "1.0.0",
    mod_group = "com.algorithmlx.additions",
    mod_description = "Optional integrations for Essential Craft: Reimagined",
    mod_license = "ASAL-1.0",
    mod_authors = "AlgorithmLX",
    minecraft_version = MINECRAFT_VERSION,
    kotlin_version = KOTLIN_VERSION,
    fabric_loader_version = "0.19.5",
    neoforge_version = NEOFORGE_VERSION,
    neoform_version = NEOFORM_VERSION,
    klf_version = "2.14.1",
    java_version = 25,
)
use_repo(ecr, "ecr_project", "ecr_additions_project")

register_toolchains("//tools/build:kotlin_toolchain")
