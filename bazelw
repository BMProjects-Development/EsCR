#!/usr/bin/env sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${JAVA_HOME:-}" ]; then
    exec "$JAVA_HOME/bin/java" "-Descr.workspace=$root" "$root/tools/build/BazelBootstrap.java" "$@"
else
    exec java "-Descr.workspace=$root" "$root/tools/build/BazelBootstrap.java" "$@"
fi
